{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDbSettings": {
    "ConnectionString": "mongodb://admin:test123@localhost:27018/?replicaSet=rs0&directConnection=true",
    "DatabaseName": "RateLimiterDB",
    "CollectionName": "rate_limits"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "BanDurationMinutes": 5
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topic": "user_requests",
    "GroupId": "rate-limiter-reader-group",
    "EnableAutoCommit": true,
    "AutoCommitIntervalMs": 5000
  }
}
